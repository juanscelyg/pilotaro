<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pilotaro_actuators</name>
  <version>0.0.0</version>
  <description>pilotaro actuators: node that sends the commands stored in the robot state to the robot actuators, and the output plugins (MotorSpeedOutput, ThrusterOutput).</description>

  <maintainer email="juanscelyg@gmail.com">Juan S. Cely G.</maintainer>

  <license>Apache License 2.0</license>

  <author>Juan S. Cely G.</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>pluginlib</depend>
  <depend>actuator_msgs</depend>
  <depend>std_msgs</depend>
  <depend>pilotaro_common</depend>
  <depend>pilotaro_core</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
