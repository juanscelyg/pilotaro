<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pilotaro_system</name>
  <version>0.0.0</version>
  <description>pilotaro: system main package (lifecycle node and real-time main loop).</description>

  <maintainer email="juanscelyg@gmail.com">Juan S. Cely G.</maintainer>

  <license>Apache License 2.0</license>

  <author>Juan S. Cely G.</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>lifecycle_msgs</depend>
  <depend>pilotaro_common</depend>
  <depend>pilotaro_core</depend>
  <depend>pilotaro_states</depend>
  <depend>pilotaro_estimators</depend>
  <depend>pilotaro_actuators</depend>
  <depend>pilotaro_controllers</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
