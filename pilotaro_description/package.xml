<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pilotaro_description</name>
  <version>0.0.0</version>
  <description>pilotaro description: URDF of the Holybro X500 with its sensors, and a script that updates the vehicle parameters of pilotaro from the URDF.</description>

  <maintainer email="juanscelyg@gmail.com">Juan S. Cely G.</maintainer>

  <license>Apache License 2.0</license>
  <!-- meshes/bluerov2/bluerov2.glb only: derived from bluerov_ros_playground -->
  <license file="meshes/bluerov2/COPYING.LESSER">LGPLv3</license>

  <author>Juan S. Cely G.</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
