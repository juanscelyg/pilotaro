<?xml version="1.0" ?>
<!--
  Copyright 2026 Juan S. Cely G.
  Licensed under the Apache License, Version 2.0

  Water for underwater vehicles: sea water below z = 0 and air above (graded buoyancy), so a
  positively buoyant vehicle floats at the surface. Sandy bottom at 10 m with some objects to
  see with the cameras and the echosounder. The hydrodynamics (added mass, damping) and the
  thrusters are systems of each vehicle model (pilotaro_description/urdf/common.xacro).
  Robots are spawned by launch/spawn.launch.py.
-->
<sdf version="1.9">
  <world name="underwater">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>

    <!-- Buoyancy of every link from the volume of its collisions: water (1000 kg/m^3)
         below z = 0, air above. Partially submerged boxes and spheres get the buoyancy of
         their submerged part -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.3 0.45 0.55 1</ambient>
      <background>0.05 0.25 0.4 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.7 0.8 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- Water surface: visual only -->
    <model name="water_surface">
      <static>true</static>
      <link name="link">
        <visual name="surface">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.0 0.3 0.5 0.5</ambient>
            <diffuse>0.0 0.3 0.5 0.5</diffuse>
            <specular>0.3 0.3 0.3 0.5</specular>
          </material>
          <transparency>0.6</transparency>
        </visual>
        <visual name="surface_below">
          <pose>0 0 0 3.14159 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.1 0.4 0.6 0.5</ambient>
            <diffuse>0.1 0.4 0.6 0.5</diffuse>
          </material>
          <transparency>0.6</transparency>
        </visual>
      </link>
    </model>

    <!-- Sandy bottom at 10 m -->
    <model name="seabed">
      <static>true</static>
      <pose>0 0 -10.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>100 100 1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>100 100 1</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.5 0.35 1</ambient>
            <diffuse>0.76 0.7 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- References on the bottom: a pipeline along x and two rocks -->
    <model name="pipeline">
      <static>true</static>
      <pose>0 3 -9.8 0 1.5708 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>30</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>30</length></cylinder></geometry>
          <material>
            <ambient>0.6 0.3 0.1 1</ambient>
            <diffuse>0.8 0.4 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="rock_1">
      <static>true</static>
      <pose>4 -2 -9.6 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.9 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.9 0.8</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="rock_2">
      <static>true</static>
      <pose>-3 -4 -9.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.7</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.7</radius></sphere></geometry>
          <material>
            <ambient>0.25 0.28 0.25 1</ambient>
            <diffuse>0.35 0.4 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
